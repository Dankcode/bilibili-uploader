AI_PROVIDER=codex
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Optional legacy Kimi provider.
# AI_PROVIDER=kimi
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
KIMI_BASE_URL=https://api.moonshot.cn/v1

# ---- Automated voiceover (video generation) ----
# These can also be set per-connection in Settings > voiceover (stored in the DB);
# env vars act as fallbacks.
# TTS engine: elevenlabs (cloud) or cosyvoice (Alibaba, local)
# TTS_BACKEND=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# CosyVoice local FastAPI server (only if TTS_BACKEND=cosyvoice):
# COSYVOICE_ENDPOINT=http://127.0.0.1:50000
# Qwen3-TTS (only if TTS_BACKEND=qwen3): DashScope cloud key, or a local server.
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com   # intl; omit for mainland
# QWEN_TTS_ENDPOINT=http://127.0.0.1:8000                  # self-hosted server (overrides cloud)
# Optional: OpenAI-compatible Whisper endpoint (e.g. Groq / self-hosted whisper.cpp).
# WHISPER_BASE_URL=https://api.openai.com/v1
# Point the voiceover translation stage at your live-translation project:
# LIVE_TRANSLATION_PATH=/absolute/path/to/live-translation

# ---- FaceFusion (automated face swap) ----
# Run scripts/install_facefusion.sh once, then set the path here or in Settings.
# FACEFUSION_DIR=/path/to/facefusion
# FACEFUSION_PYTHON=python
# FACEFUSION_EP=cuda   # or cpu

# YouTube OAuth files are intentionally local-only.
# The API uploader expects per-channel files like:
# <channel-id>_client_secret.json
# <channel-id>_token.pickle
YOUTUBE_UPLOAD_METHOD=api
YOUTUBE_CHANNEL_ID=

# Optional guided desktop uploader for the pygui-upload fork.
# It pauses for manual login/verification and stores local click points in config/.
# YOUTUBE_UPLOAD_METHOD=pygui
YOUTUBE_PYGUI_PROFILE=config/pygui_upload_profile.json
YOUTUBE_STUDIO_URL=https://studio.youtube.com
YOUTUBE_PYGUI_AUTO_LOGIN=false
YOUTUBE_PYGUI_KEYRING_SERVICE=bilibili-uploader.youtube
YOUTUBE_PYGUI_LOGIN_WAIT_SECONDS=3
