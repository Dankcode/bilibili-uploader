AI_PROVIDER=codex
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# ---- Runtime topology ----
# Settings > Connections writes connection mode, SQLite path, worker intervals,
# and masked access tokens to config/runtime-settings.json. These environment
# values are optional deployment overrides for server-managed installations.
# VIDEO_RUNTIME_SETTINGS_PATH=/absolute/path/to/runtime-settings.json
# VIDEO_SQLITE_PATH=/absolute/path/to/bilibili.db
# VIDEO_SERVER_API_TOKEN=replace-with-a-long-random-token

# Kimi text + multimodal provider. Subtitle Studio sends each selected
# screenshot plus the Whisper draft excerpts that overlap its time window.
# AI_PROVIDER=kimi
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-32k
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_VISION_MODEL=kimi-k2.6
# KIMI_VISION_BATCH_SIZE=4
# KIMI_VISION_TIMEOUT_MS=120000

# Gemini text provider and legacy vision-correction adapter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Subtitle Studio screenshot-context backend. The timed context workflow
# currently requires kimiVision; unsupported adapters are reported unavailable.
# Unset selects Kimi automatically when KIMI_API_KEY is configured.
# VISION_BACKEND=kimiVision

# ---- Subtitle Studio / local Whisper ----
# Models cache under ~/.bilibili-uploader/models by default and download on
# first use. Set STUDIO_OFFLINE=1 only after the selected model is cached.
# WHISPER_MODEL_DIR=/absolute/path/to/models
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# FFPROBE_PATH=/absolute/path/to/ffprobe
# STUDIO_OFFLINE=0
# STUDIO_ALLOW_REMOTE_MODELS=true
# Defaults to ModelScope with Hugging Face fallback. Override both values for
# another Transformers.js-compatible model host.
# STUDIO_MODEL_HOST=https://modelscope.cn/models/
# STUDIO_MODEL_REVISION=master
# VIDEO_WORK_DIR=video-work

# Transcript analysis uses one of the configured API providers above.
# When unset, Studio selects the first provider with an API key.
# STUDIO_ANALYSIS_PROVIDER=kimi   # kimi | gemini

# Screenshot context is optional. When Kimi is not configured, Studio keeps
# local Whisper available but disables the Kimi context and context-assisted
# rerun steps with an explicit status.
# GEMINI_VISION_MODEL=gemini-2.0-flash
# VISION_BATCH_SIZE=8

# ---- Automated voiceover (video generation) ----
# These can also be set per-connection in Settings > voiceover (stored in the DB);
# env vars act as fallbacks.
# TTS engine: elevenlabs (cloud) or cosyvoice (Alibaba, local)
# TTS_BACKEND=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# CosyVoice local FastAPI server (only if TTS_BACKEND=cosyvoice):
# COSYVOICE_ENDPOINT=http://127.0.0.1:50000
# Qwen3-TTS (only if TTS_BACKEND=qwen3): DashScope cloud key, or a local server.
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com   # intl; omit for mainland
# QWEN_TTS_ENDPOINT=http://127.0.0.1:8000                  # self-hosted server (overrides cloud)
# Optional: OpenAI-compatible Whisper endpoint. In Connections, choose
# sttBackend=openaiWhisper or localWhisper and fast/balanced/best quality.
# WHISPER_BASE_URL=https://api.openai.com/v1
# Point the voiceover translation stage at your live-translation project:
# LIVE_TRANSLATION_PATH=/absolute/path/to/live-translation

# ---- FaceFusion (automated face swap) ----
# Run scripts/install_facefusion.sh once, then set the path here or in Settings.
# FACEFUSION_DIR=/path/to/facefusion
# FACEFUSION_PYTHON=python
# FACEFUSION_EP=cuda   # or cpu

# YouTube OAuth files are intentionally local-only.
# The API uploader expects per-authorization files like:
# <credential-ref>_client_secret.json
# <credential-ref>_token.json (created after OAuth consent)
YOUTUBE_UPLOAD_METHOD=api
# Optional legacy fallback. Prefer selecting a registered authorization per job.
YOUTUBE_CHANNEL_ID=

# Release layer: per-OAuth-client (Google Cloud project) daily Data API budget.
# Uploads that do not fit DEFER to 00:00 Pacific instead of failing.
# Defaults: 10,000 units/day; 1,601 per upload (videos.insert + channels.list);
# 2 per reconcile of an unconfirmed upload (channels.list + playlistItems.list).
# YOUTUBE_DAILY_QUOTA_UNITS=10000
# YOUTUBE_UPLOAD_UNITS=1601
# YOUTUBE_RECONCILE_UNITS=2

# Upload method default for new jobs (each job can choose its own in the planner):
#   api    — YouTube Data API with an authorized channel (uses daily quota)
#   studio — image-driven YouTube Studio automation: pyautogui finds each control
#            by matching screen templates captured on this machine, in a browser
#            already signed into the channel. No API, OAuth or quota.
#            Capture templates first:
#            python3 scripts/python/youtube_studio_vision_uploader.py --calibrate
#   pygui  — older guided uploader (fills fields, a person finishes in Studio)
# YOUTUBE_STUDIO_TEMPLATE_DIR=config/studio_templates/default
# YOUTUBE_STUDIO_STEP_TIMEOUT_SECONDS=45
# YOUTUBE_STUDIO_HUMAN_WAIT_SECONDS=600
# YOUTUBE_STUDIO_UPLOAD_WAIT_MINUTES=60
# YOUTUBE_STUDIO_TIMEOUT_MINUTES=120
# YOUTUBE_STUDIO_LIMIT_RETRY_HOURS=6
# YOUTUBE_STUDIO_ZOOM_SCALES=1.0,0.9,1.1

# Optional guided desktop uploader for the pygui-upload fork.
# It pauses for manual login/verification and stores local click points in config/.
# YOUTUBE_UPLOAD_METHOD=pygui
YOUTUBE_PYGUI_PROFILE=config/pygui_upload_profile.json
YOUTUBE_STUDIO_URL=https://studio.youtube.com
YOUTUBE_PYGUI_AUTO_LOGIN=false
YOUTUBE_PYGUI_KEYRING_SERVICE=bilibili-uploader.youtube
YOUTUBE_PYGUI_LOGIN_WAIT_SECONDS=3
