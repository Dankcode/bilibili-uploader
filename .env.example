AI_PROVIDER=codex
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Optional legacy Kimi provider.
# AI_PROVIDER=kimi
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
KIMI_BASE_URL=https://api.moonshot.cn/v1

# YouTube OAuth files are intentionally local-only.
# The API uploader expects per-channel files like:
# <channel-id>_client_secret.json
# <channel-id>_token.pickle
YOUTUBE_UPLOAD_METHOD=api
YOUTUBE_CHANNEL_ID=

# Optional guided desktop uploader for the pygui-upload fork.
# It pauses for manual login/verification and stores local click points in config/.
# YOUTUBE_UPLOAD_METHOD=pygui
YOUTUBE_PYGUI_PROFILE=config/pygui_upload_profile.json
YOUTUBE_STUDIO_URL=https://studio.youtube.com
YOUTUBE_PYGUI_AUTO_LOGIN=false
YOUTUBE_PYGUI_KEYRING_SERVICE=bilibili-uploader.youtube
YOUTUBE_PYGUI_LOGIN_WAIT_SECONDS=3
