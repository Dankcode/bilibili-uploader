AI_PROVIDER=codex
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Optional legacy Kimi provider.
# AI_PROVIDER=kimi
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-32k
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Gemini — also used for image/vision tasks (Subtitle Studio frame
# correction) and as automatic text fallback when Kimi is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Subtitle Studio vision backend: gemini | codex | local | kimiVision
# (unset = gemini when GEMINI_API_KEY is set, otherwise stage is skipped)
# VISION_BACKEND=gemini

# ---- Subtitle Studio / local Whisper ----
# Models cache under ~/.bilibili-uploader/models by default and download on
# first use. Set STUDIO_OFFLINE=1 only after the selected model is cached.
# WHISPER_MODEL_DIR=/absolute/path/to/models
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# FFPROBE_PATH=/absolute/path/to/ffprobe
# STUDIO_OFFLINE=0
# STUDIO_ALLOW_REMOTE_MODELS=true
# Defaults to ModelScope with Hugging Face fallback. Override both values for
# another Transformers.js-compatible model host.
# STUDIO_MODEL_HOST=https://modelscope.cn/models/
# STUDIO_MODEL_REVISION=master
# VIDEO_WORK_DIR=video-work

# Transcript analysis uses one of the configured API providers above.
# When unset, Studio selects the first provider with an API key.
# STUDIO_ANALYSIS_PROVIDER=kimi   # kimi | gemini

# Vision correction is optional. When no configured provider is available,
# Studio reports "Vision correction was skipped due to no provider."
# A configured Gemini key is selected automatically when VISION_BACKEND is unset.
# VISION_BACKEND=gemini   # gemini | codex | local | kimiVision
# GEMINI_VISION_MODEL=gemini-2.0-flash
# VISION_BATCH_SIZE=8

# ---- Automated voiceover (video generation) ----
# These can also be set per-connection in Settings > voiceover (stored in the DB);
# env vars act as fallbacks.
# TTS engine: elevenlabs (cloud) or cosyvoice (Alibaba, local)
# TTS_BACKEND=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# CosyVoice local FastAPI server (only if TTS_BACKEND=cosyvoice):
# COSYVOICE_ENDPOINT=http://127.0.0.1:50000
# Qwen3-TTS (only if TTS_BACKEND=qwen3): DashScope cloud key, or a local server.
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com   # intl; omit for mainland
# QWEN_TTS_ENDPOINT=http://127.0.0.1:8000                  # self-hosted server (overrides cloud)
# Optional: OpenAI-compatible Whisper endpoint. In Connections, choose
# sttBackend=openaiWhisper or localWhisper and fast/balanced/best quality.
# WHISPER_BASE_URL=https://api.openai.com/v1
# Point the voiceover translation stage at your live-translation project:
# LIVE_TRANSLATION_PATH=/absolute/path/to/live-translation

# ---- FaceFusion (automated face swap) ----
# Run scripts/install_facefusion.sh once, then set the path here or in Settings.
# FACEFUSION_DIR=/path/to/facefusion
# FACEFUSION_PYTHON=python
# FACEFUSION_EP=cuda   # or cpu

# YouTube OAuth files are intentionally local-only.
# The API uploader expects per-channel files like:
# <channel-id>_client_secret.json
# <channel-id>_token.pickle
YOUTUBE_UPLOAD_METHOD=api
YOUTUBE_CHANNEL_ID=

# Optional guided desktop uploader for the pygui-upload fork.
# It pauses for manual login/verification and stores local click points in config/.
# YOUTUBE_UPLOAD_METHOD=pygui
YOUTUBE_PYGUI_PROFILE=config/pygui_upload_profile.json
YOUTUBE_STUDIO_URL=https://studio.youtube.com
YOUTUBE_PYGUI_AUTO_LOGIN=false
YOUTUBE_PYGUI_KEYRING_SERVICE=bilibili-uploader.youtube
YOUTUBE_PYGUI_LOGIN_WAIT_SECONDS=3
