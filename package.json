{
  "name": "bilibili-uploader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "mcp": "node scripts/mcp/server.mjs",
    "mcp:setup": "node scripts/mcp/setup.mjs",
    "dev": "node scripts/run_server.mjs dev",
    "dev:web": "next dev -H 0.0.0.0 -p 4455",
    "worker": "node --import ./scripts/register_loader.mjs scripts/server_worker.mjs",
    "build": "next build",
    "start": "node scripts/run_server.mjs start",
    "start:web": "next start -H 0.0.0.0 -p 4455",
    "lint": "next lint",
    "test": "node --import ./test/setup.mjs --test test/*.test.mjs",
    "proof:face-swap": "node scripts/prove_facefusion.mjs"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "axios": "^1.18.0",
    "better-sqlite3": "^12.8.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^176.0.0",
    "lucide-react": "^1.31.0",
    "next": "14.2.35",
    "openai": "^4.53.0",
    "playwright": "^1.45.1",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.1"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
