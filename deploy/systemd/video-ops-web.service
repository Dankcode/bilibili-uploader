[Unit]
Description=Video Operations web backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vops
WorkingDirectory=/srv/bilibili-uploader
EnvironmentFile=/srv/bilibili-uploader/config/server.env
Environment=VIDEO_PROCESS_ROLE=frontend
Environment=VIDEO_ACCESS_MODE=tailscale
Environment=VIDEO_BIND_HOST=127.0.0.1
ExecStart=/usr/bin/node /srv/bilibili-uploader/scripts/run_server.mjs start --web-only
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
