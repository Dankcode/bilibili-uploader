[Unit]
Description=Video Operations web backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vops
WorkingDirectory=/srv/bilibili-uploader
EnvironmentFile=/srv/bilibili-uploader/config/server.env
Environment=VIDEO_PROCESS_ROLE=frontend
ExecStart=/usr/bin/node /srv/bilibili-uploader/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 4455
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
